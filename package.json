{
	"name": "zeromail-app",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --filter=web",
		"dev:docs": "dotenv -c -- turbo dev --filter=docs",
		"dev:mail": "dotenv -c -- turbo dev --filter=mail-preview",
		"dev:full": "dotenv -c -- turbo dev --concurrency 6",
		"type-check": "dotenv -c -- turbo type-check",
		"start": "dotenv -c -- turbo start",
		"lint": "biome lint",
		"check": "biome check --write",
		"clean": "turbo clean",
		"format": "biome format --write",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^26.6.5",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"turbo": "^2.11.4",
		"typescript": "5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@prisma/client",
			"@prisma/engines",
			"@swc/core",
