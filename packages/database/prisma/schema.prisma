datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client"
  output        = "./generated"
  engineType    = "client"
  binaryTargets = ["native"]
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  username           String?
  role               String?
  banned             Boolean?
  banReason          String?
  banExpires         DateTime?
  onboardingComplete Boolean      @default(false)
  paymentsCustomerId String?
  locale             String?
  displayUsername    String?
  twoFactorEnabled   Boolean?
  accountType        AccountType  @default(STANDARD)
  // Set the first time this user ever views an AI inbox summary. Backs the
  // once-per-lifetime `first_summary_viewed` GA4 conversion (device-independent,
  // unlike the old localStorage guard).
  firstSummaryViewedAt DateTime?
  // Soft account lockout (CASA 1.1.1 anti-automation control) for the
  // password sign-in endpoint. Consecutive failed attempts increment
  // failedLoginAttempts; hitting the threshold sets lockedUntil and blocks
  // further attempts until it elapses. Both reset to 0/null on a successful
  // sign-in. Complements the IP-based rate limiting in
  // packages/api/lib/rate-limit.ts, which can't stop an attacker rotating
  // IPs against one account.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Set on accounts whose initial password was generated by the system
  // (tooling/scripts/src/create-user.ts) rather than chosen by the user
  // (CASA 1.1.2: system-generated initial passwords must expire after a
  // short period). Gates access to /app until the user sets their own
  // password via ChangePasswordForm; cleared by the /change-password hook
  // in packages/auth/auth.ts.
  mustChangePassword Boolean    @default(false)
  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  invitations        Invitation[]
  purchases          Purchase[]
  members            Member[]
  twofactors         TwoFactor[]
  mailbox            Mailbox[]
  notifications      Notification[]
  aiConversations    AiConversation[]
  reminders          Reminder[]
  paymentCards       PaymentCard[]
  telegramConnections TelegramConnection[]
  telegramLinkTokens  TelegramLinkToken[]
  telegramActions     TelegramAction[]
  telegramBriefings   TelegramBriefing[]
  creatorProfile      CreatorProfile?
  voiceUsage          VoiceUsageTracking[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

enum AccountType {
  STANDARD
  FREELANCER
  CREATOR
}

enum ProfileLayout {
  STANDARD
  COMPACT
}

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public-page identity — independent of the account's name/image (User.name /
  // User.image, used for login, nav bar, etc.). Null falls back to those.
  displayName String?
  avatarUrl   String? // storage path, e.g. `profile-${userId}.png?v=...` — proxy through /image-proxy/avatars/

  bio             String? @db.Text
  links           Json    @default("[]") // [{ label, url }]
  enabled         Boolean @default(false)
  bookingEnabled  Boolean @default(false)
  bookingTimezone String  @default("Asia/Calcutta") // IANA name; slots are computed in this zone
  meetingLengthMinutes Int @default(30)

  // Branding (Phase 3)
  accentColor String        @default("#6E3BFF") // hex, validated at the API layer
  layout      ProfileLayout @default(STANDARD)

  // Page design (Phase 3b) — buttons/colors/font/wallpaper, layered on top of accentColor/layout above.
  // { buttonStyle: "fill"|"outline"|"soft", backgroundColor: hex, textColor: hex, font: string,
  //   wallpaperStyle: "fill"|"gradient"|"blur"|"pattern"|"background", patternType: "noise"|"grid"|"blob"|"dots",
  //   backgroundType: "sunset"|"ocean"|"forest"|"candy"|"midnight"|"peach"|"prism"|"lava"|"plasma"|"pulse"|"vortex"|"mist"|"stars"|"particles"
  //     |"sunsetGlow"|"oceanicDepth"|"forestCanopy"|"cosmicNebula"|"desertDawn"|"fieryEmbers"|"lavenderDreams"|"arcticHaze"|"retroWave"|"violetGlow"|"elegantDark"
  //     |"livingOrigami"|"paperShader"|"softGlow",
  //   wallpaperOpacity: 0-1 }
  design Json @default("{}")

  // Media kit (Phase 3, Creator accounts only — enforced at the API layer)
  mediaKitEnabled Boolean @default(false)
  mediaKit        Json    @default("{}") // { stats: [{label, value}], collaborations: [{label, url}], rateCard: [{label, price}] }

  // Directory & discovery (Phase 4)
  tags            String[] @default([]) // free-text, lowercased at the API layer
  directoryListed Boolean  @default(false) // opt-in, separate from `enabled` (public page can be on without directory listing)

  // Paid bookings (Phase 5) — single fixed platform price (see packages/payments/config.ts),
  // not a per-creator custom amount. Opt-in, layered on top of bookingEnabled.
  paidBookingEnabled Boolean @default(false)

  availability WeeklyAvailability[]
  bookings     Booking[]
  events       ProfileEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Directory listing scans enabled+listed profiles ordered by id for cursor
  // pagination; tag filtering is applied in-memory on the `tags` array via
  // Postgres's `hasSome`, which doesn't benefit from a btree index here.
  @@index([directoryListed, enabled, id])
  @@map("creator_profile")
}

enum ProfileEventType {
  VIEW
  CONTACT
  BOOKING
}

// Append-only analytics log for a creator's public profile. Kept intentionally
// thin (no visitor PII beyond what's already public) — aggregated on read by
// the analytics queries rather than pre-rolled into counters.
model ProfileEvent {
  id               String           @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  type ProfileEventType

  createdAt DateTime @default(now())

  @@index([creatorProfileId, type, createdAt])
  @@map("profile_event")
}

// A recurring weekly open window, e.g. "Monday 09:00-17:00". Times are local
// to CreatorProfile.bookingTimezone, stored as "HH:mm" strings (no date math
// against DST at rest — resolved to instants only when computing slots).
model WeeklyAvailability {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  dayOfWeek Int    // 0 (Sunday) .. 6 (Saturday)
  startTime String // "HH:mm", 24h
  endTime   String // "HH:mm", 24h

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorProfileId])
  @@map("weekly_availability")
}

enum BookingStatus {
  PENDING // awaiting the host's Accept/Decline
  ACCEPTING // transient CAS lock while the accept workflow runs — never shown to users
  CONFIRMED // host accepted; meeting + calendar event + confirmation email all succeeded
  DECLINED // host explicitly declined
  CANCELED // visitor canceled (via cancelToken), before or after acceptance
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Booking {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  visitorName  String
  visitorEmail String
  note         String? @db.Text

  startsAt DateTime
  endsAt   DateTime
  status   BookingStatus @default(PENDING)

  cancelToken String @unique // lets the visitor cancel without an account

  // Paid bookings (Phase 5) — null for free bookings. checkoutId is Polar's
  // checkout session id, used to correlate the order.created webhook back to
  // this booking and to guard against duplicate webhook delivery.
  paid       Boolean @default(false)
  checkoutId String? @unique

  // Host acceptance workflow — populated incrementally as each step of Accept
  // succeeds, so a partial failure can resume from where it left off instead
  // of recreating the Meet/Calendar event or re-sending the email.
  meetLink                String?
  calendarEventId         String?
  acceptedAt              DateTime?
  confirmationEmailStatus EmailDeliveryStatus?
  confirmationEmailSentAt DateTime?
  acceptError             String? @db.Text // last failure reason; cleared on success
  declinedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Overlap checks and public slot computation both scan a profile's active
  // bookings ordered by time.
  @@index([creatorProfileId, status, startsAt])
  @@map("booking")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  // Better Auth's own login-password hash (email/password sign-in). Never
  // reused for IMAP mailbox credentials below — those are a different secret
  // for a different system and mixing them into one column would be a real
  // security bug.
  password     String?

  // Generic IMAP/SMTP mailbox credentials (providerId "imap"), set only for
  // custom-domain mailboxes connected outside Better Auth's OAuth flow — this
  // Account row is created directly by connect-imap-mailbox.ts, not by Better
  // Auth. imapPasswordEncrypted is AES-256-GCM via encryptToken/decryptToken
  // (@repo/utils), the same scheme already used for accessToken/refreshToken.
  imapHost              String?
  imapPort              Int?
  imapSecure            Boolean?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean?
  imapPasswordEncrypted String?   @db.Text

  mailbox Mailbox?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Mailbox {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name     String?
  email    String
  picture  String?
  provider MailboxProvider @default(GOOGLE)

  // Watch & sync state
  watchEnabled              Boolean   @default(false)
  watchExpiry               DateTime?
  lastHistoryId             String?
  subscriptionId            String?
  subscriptionClientState   String?

  rules              Rule[]
  executionLogs      RuleExecutionLog[]
  usageTracking      MailboxUsageTracking[]
  backfillRuns       RuleBackfillRun[]
  classificationRuns EmailClassificationRun[]
  emails             Email[]
  scheduledEmails    ScheduledEmail[]
  snoozedEmails      SnoozedEmail[]
  reminders          Reminder[]
  aiConversations    AiConversation[]
  telegramActions    TelegramAction[]
  telegramBriefings  TelegramBriefing[]
  paymentCards       PaymentCard[]

  // Full sync state
  emailSyncComplete Boolean  @default(false)
  emailSyncCursor   String?  // oldest internalDate reached during sync (ISO string)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@map("mailbox")
}

model PendingImapMailbox {
  id String @id @default(cuid())

  email String @unique

  imapHost   String
  imapPort   Int
  imapSecure Boolean
  smtpHost   String
  smtpPort   Int
  smtpSecure Boolean

  passwordEncrypted String @db.Text

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("pending_imap_mailbox")
}

model MailboxUsageTracking {
  id              String   @id @default(cuid())

  mailboxId       String
  mailbox         Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  periodStart     DateTime
  periodEnd       DateTime
  emailsProcessed Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([mailboxId, periodStart])
  @@index([mailboxId])
  @@index([periodStart])
  @@index([periodEnd])
  @@map("mailbox_usage_tracking")
}

// Voice transcription is per-user (used from the AI assistant composer, not
// scoped to a single mailbox), unlike email processing above.
model VoiceUsageTracking {
  id            String   @id @default(cuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart   DateTime
  periodEnd     DateTime
  secondsUsed   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodStart])
  @@index([userId])
  @@index([periodStart])
  @@index([periodEnd])
  @@map("voice_usage_tracking")
}

enum ScheduledEmailStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model ScheduledEmail {
  id        String   @id @default(cuid())

  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  to       String
  cc       String?
  bcc      String?
  subject  String
  body     String

  scheduledAt DateTime
  status      ScheduledEmailStatus @default(PENDING)
  sentAt      DateTime?
  messageId   String?
  error       String?
  attempts    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  // Cron polls due PENDING rows ordered by scheduledAt.
  @@index([status, scheduledAt])
  @@map("scheduled_email")
}

enum SnoozeStatus {
  SNOOZED
  RETURNED
  CANCELED
}

model SnoozedEmail {
  id        String   @id @default(cuid())

  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  messageId String   // Gmail message id (== local Email.id)
  threadId  String?

  // Denormalized display fields so the Snoozed list renders without a live
  // Gmail fetch and works even when there is no local Email row.
  from         String
  subject      String
  snippet      String
  internalDate DateTime
  isUnread     Boolean  @default(true)

  // Labels removed at snooze time, restored on wake.
  originalLabelIds String[]

  snoozeUntil DateTime
  status      SnoozeStatus @default(SNOOZED)
  returnedAt  DateTime?
  error       String?
  attempts    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  // Poller scans due SNOOZED rows ordered by snoozeUntil.
  @@index([status, snoozeUntil])
  @@map("snoozed_email")
}

enum ReminderStatus {
  PENDING
  FIRED
  CANCELED
}

model Reminder {
  id        String   @id @default(cuid())

  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String @db.Text

  remindAt DateTime
  status   ReminderStatus @default(PENDING)
  firedAt  DateTime?
  error    String?
  attempts Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  // Poller scans due PENDING rows ordered by remindAt.
  @@index([status, remindAt])
  @@map("reminder")
}

model Rule {
  id        String    @id @default(cuid())

  mailboxId String
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  name      String
  enabled   Boolean   @default(true)
  condition Json      // { conditionalOperator, aiInstructions, static: { from, to, subject } }
  actions   Json      @default("[]") // [{ type, fields: { label, to, cc, bcc, subject, content, webhookUrl, folderName } }]

  executionLogs RuleExecutionLog[]
  backfillRuns   RuleBackfillRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  @@map("rule")
}

model RuleBackfillRun {
  id String @id @default(cuid())

  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  status String
  windowMonths Int
  windowStart DateTime
  windowEnd DateTime
  query String?
  nextPageToken String?
  estimatedTotal Int?
  processedCount Int @default(0)
  matchedCount Int @default(0)
  appliedCount Int @default(0)
  skippedCount Int @default(0)
  errorCount Int @default(0)
  lastError String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  @@index([ruleId])
  @@index([status])
  @@map("rule_backfill_run")
}

model RuleExecutionLog {
  id        String   @id @default(cuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  messageId   String
  threadId    String?
  subject     String?
  from        String?

  status      String    // "matched" | "not_matched" | "error"
  actionsRun  Json      @default("[]")
  error       String?

  createdAt   DateTime  @default(now())

  @@index([ruleId])
  @@index([mailboxId])
  @@index([messageId])
  @@map("rule_execution_log")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // better-auth 1.7's twoFactor plugin: tracks verification attempts against
  // this factor (rate-limiting/lockout for repeated bad OTP/TOTP codes).
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  productId      String
  status         String?
  trialEndsAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String
  // Gmail message ID the notification refers to, if any (not a DB relation —
  // emails can be resynced/deleted independently of their notifications).
  emailId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notification")
}

model Email {
  id           String   @id  // Gmail message ID (globally unique)

  mailboxId    String
  mailbox      Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  threadId     String
  from         String
  fromEmail    String
  to           String
  subject      String
  snippet      String   @db.Text
  bodyText     String   @db.Text
  bodyHtml     String   @db.Text
  labelIds     String[]
  isUnread     Boolean  @default(true)
  internalDate DateTime

  category      CategoryLabel?
  categorizedAt DateTime?

  // null = not yet scanned for payment relevance; "payment" | "not-payment"
  // once payment-classifier.ts has run — prevents the payment poller from
  // re-classifying the same non-payment email forever.
  paymentScanCategory String?
  paymentCards        PaymentCard[]

  syncedAt     DateTime @default(now())

  @@index([mailboxId])
  @@index([mailboxId, internalDate(sort: Desc)])
  @@index([mailboxId, category])
  @@index([mailboxId, paymentScanCategory])
  @@map("email")
}

enum MailboxProvider {
  GOOGLE
  OUTLOOK
  IMAP
}

model AiConversation {
  id        String @id @default(cuid())

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  title     String @default("New chat")

  messages  AiChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, mailboxId, updatedAt(sort: Desc)])
  @@map("ai_conversation")
}

model AiChatMessage {
  id             String @id @default(cuid())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String // "user" | "assistant"
  // Full UIMessage (parts[], including tool/citation parts) stored verbatim for faithful replay.
  parts          Json

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_chat_message")
}

enum CategoryLabel {
  PRIMARY
  NEWSLETTER
  PROMOTION
  SOCIAL
}

model EmailClassificationRun {
  id String @id @default(cuid())

  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  status String // "pending" | "running" | "completed" | "failed"

  cursor          String? // last processed Email.internalDate (ISO string), for resume
  totalAtStart    Int? // uncategorized count when the run was created — progress-bar denominator only
  processedCount  Int     @default(0)
  classifiedCount Int     @default(0)
  errorCount      Int     @default(0)
  lastError       String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
  @@index([status])
  @@map("email_classification_run")
}

enum PaymentKanbanStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  PAID
}

enum PaymentStatusSource {
  AUTOMATIC
  MANUAL
}

model PaymentCard {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  emailId String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  threadId String

  // AI-extracted (payment-classifier.ts) — absent fields mean "not detected",
  // never guessed.
  paymentType   String // "invoice" | "bill" | "subscription" | "receipt" | "reminder" | "other"
  merchant      String
  amount        Float?
  currency      String? // ISO 4217, e.g. "USD"
  dueDate       DateTime?
  paymentStatus String // AI's read of the email itself: "unpaid" | "paid" | "overdue" | "unknown"
  confidence    Float

  // Code-derived (payment-status-deriver.ts), not AI-derived.
  kanbanStatus PaymentKanbanStatus @default(UPCOMING)

  // Once MANUAL, automation may update descriptive fields above but must never
  // touch kanbanStatus/statusSource/manuallyOverriddenAt again — see
  // payment-card-writer.ts.
  statusSource         PaymentStatusSource @default(AUTOMATIC)
  manuallyOverriddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mailboxId, emailId])
  @@index([userId, kanbanStatus])
  @@index([mailboxId, dueDate])
  @@map("payment_card")
}

model TelegramConnection {
  id String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId String @unique
  chatId         String @unique
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  enabled         Boolean   @default(true)
  timezone        String    @default("Asia/Calcutta")
  dailyDigestTime String    @default("09:00")
  lastBriefingSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("telegram_connection")
}

model TelegramLinkToken {
  id String @id @default(cuid())
  token String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_link_token")
}

model TelegramAction {
  id String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messageId String
  action    TelegramActionType
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([mailboxId, messageId])
  @@index([expiresAt])
  @@map("telegram_action")
}

model TelegramBriefing {
  id String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  briefingDate DateTime
  categoryCounts Json
  messageIds     String[]
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  @@index([userId, sentAt])
  @@index([mailboxId, briefingDate])
  @@map("telegram_briefing")
}

enum TelegramActionType {
  ARCHIVE
  MARK_READ
  TRASH
}
