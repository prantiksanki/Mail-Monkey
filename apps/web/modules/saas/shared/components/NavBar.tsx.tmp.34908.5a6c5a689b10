"use client";

import { authClient } from "@repo/auth/client";
import { config as authConfig } from "@repo/auth/config";
import { cn, Logo } from "@repo/ui";
import {
	Tooltip,
	TooltipContent,
	TooltipProvider,
	TooltipTrigger,
} from "@repo/ui/components/tooltip";
import { useSession } from "@saas/auth/hooks/use-session";
import { useActiveOrganization } from "@saas/organizations/hooks/use-active-organization";
import { UserMenu } from "@saas/shared/components/UserMenu";
import {
	BookIcon,
	CalendarDaysIcon,
	ClockIcon,
	HomeIcon,
	InboxIcon,
	LayoutDashboardIcon,
	ListFilterIcon,
	LogOutIcon,
	MailIcon,
	PencilIcon,
	PlusIcon,
	SearchIcon,
	SendIcon,
	SettingsIcon,
	SparklesIcon,
	Trash2Icon,
	UserCogIcon,
} from "lucide-react";
import { useSelectedMailbox } from "@saas/mailboxes/lib/selected-mailbox-context";
import { useRulesQuery } from "@saas/mailboxes/lib/rules-api";
import Link from "next/link";
import { usePathname, useSearchParams } from "next/navigation";
import { useTranslations } from "next-intl";
import { config as webConfig } from "@/config";
import { OrganzationSelect } from "../../organizations/components/OrganizationSelect";
import { useSidebar } from "../lib/sidebar-context";
import { Button } from "@repo/ui";

const LABEL_COLORS = [
	"#F28B82",
	"#FBBC04",
	"#34A853",
	"#4285F4",
	"#AB47BC",
	"#FF7043",
	"#26A69A",
	"#EC407A",
	"#8E24AA",
	"#00897B",
];

function labelColor(name: string): string {
	let hash = 0;
	for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
	return LABEL_COLORS[Math.abs(hash) % LABEL_COLORS.length];
}

function getActiveSection(pathname: string, basePath: string): string {
	if (pathname === basePath || pathname === "/app") return "dashboard";
	if (pathname.startsWith("/app/calendar")) return "calendar";
	if (pathname.startsWith("/app/rules/assistant")) return "ai";
	if (pathname.startsWith("/app/rules")) return "rules";
	if (pathname.startsWith("/app/mailboxes")) return "mail";
	return "mail";
}

function NavItem({
	href,
	icon: Icon,
	label,
	isActive,
}: {
	href: string;
	icon: React.ElementType;
	label: string;
	isActive: boolean;
}) {
	return (
		<Link
			href={href}
			className={cn(
				"flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors",
				isActive
					? "text-foreground font-semibold"
					: "text-muted-foreground hover:text-foreground hover:bg-black/5",
			)}
		>
			<Icon
				className={cn(
					"size-4 shrink-0",
					isActive ? "text-foreground" : "text-muted-foreground",
				)}
			/>
			<span>{label}</span>
		</Link>
	);
}

export function NavBar() {
	const t = useTranslations();
	const pathname = usePathname();
	const { user } = useSession();
	const { activeOrganization, isOrganizationAdmin } = useActiveOrganization();
	const searchParams = useSearchParams();
	const { selectedMailboxId } = useSelectedMailbox();
	const { data: rulesData } = useRulesQuery(selectedMailboxId);

	const labelRules = (rulesData?.rules ?? [])
		.filter((r) =>
			(r as { actions: Array<{ type: string; fields?: Record<string, unknown> }> })
				.actions.some((a) => a.type === "LABEL" && a.fields?.label),
		)
		.map((r) => {
			const rule = r as {
				id: string;
				name: string;
				actions: Array<{ type: string; fields?: Record<string, unknown> }>;
			};
			const labelAction = rule.actions.find((a) => a.type === "LABEL");
			const labelName = (labelAction?.fields?.label as string) ?? rule.name;
			return { id: rule.id, name: labelName, color: labelColor(labelName) };
		});

	const { useSidebarLayout } = webConfig.saas;

	const basePath = activeOrganization
		? `/app/${activeOrganization.slug}`
		: "/app";

	const activeSection = getActiveSection(pathname, basePath);

	const onLogout = () => {
		authClient.signOut({
			fetchOptions: {
				onSuccess: async () => {
					window.location.href = new URL(
						webConfig.saas.redirectAfterLogout,
						window.location.origin,
					).toString();
				},
			},
		});
	};

	if (!useSidebarLayout) {
		return (
			<nav className="w-full bg-card border-b">
				<div className="container max-w-6xl py-4 flex items-center justify-between gap-6">
					<Link href="/app" className="block">
						<Logo withLabel={true} />
					</Link>
					<ul className="flex list-none items-center gap-2 text-sm">
						{[
							{
								label: t("app.menu.dashboard"),
								href: basePath,
								icon: LayoutDashboardIcon,
								isActive: pathname === basePath,
							},
							{
								label: "Mail",
								href: "/app/mailboxes",
								icon: MailIcon,
								isActive: pathname.startsWith("/app/mailboxes"),
							},
							{
								label: t("app.menu.calendar"),
								href: "/app/calendar",
								icon: CalendarDaysIcon,
								isActive: pathname.startsWith("/app/calendar"),
							},
							{
								label: t("app.menu.rules"),
								href: "/app/rules",
								icon: ListFilterIcon,
								isActive:
									pathname.startsWith("/app/rules") &&
									!pathname.startsWith("/app/rules/assistant"),
							},
							{
								label: t("app.menu.aiAssistant"),
								href: "/app/rules/assistant",
								icon: SparklesIcon,
								isActive: pathname.startsWith("/app/rules/assistant"),
							},
						].map((item) => (
							<li key={item.href}>
								<Link
									href={item.href}
									className={cn(
										"flex items-center gap-2 rounded-lg px-3 py-2 transition-colors",
										item.isActive
											? "font-semibold bg-card border border-border"
											: "hover:bg-muted/50",
									)}
								>
									<item.icon className="size-4 shrink-0" />
									<span>{item.label}</span>
								</Link>
							</li>
						))}
					</ul>
					<UserMenu />
				</div>
			</nav>
		);
	}

	return (
		<TooltipProvider delayDuration={0}>
			{/* Single flat sidebar — Fyxer style */}
			<aside
				className="fixed top-0 left-0 bottom-0 z-40 flex flex-col w-(--sidebar-width) bg-[#F9F9F7] border-r"
			>
				{/* Logo */}
				<div className="flex items-center justify-between px-4 h-14 shrink-0 border-b border-border/60">
					<Link href="/app" className="flex items-center">
						<Logo withLabel={true} />
					</Link>
				</div>

				{/* Nav items */}
				<div className="flex-1 overflow-y-auto py-3 px-2 flex flex-col gap-0.5">

					{/* Primary nav */}
					<NavItem
						href={basePath}
						icon={LayoutDashboardIcon}
						label={t("app.menu.dashboard")}
						isActive={activeSection === "dashboard"}
					/>
					<NavItem
						href="/app/mailboxes?folder=inbox"
						icon={MailIcon}
						label="Mail"
						isActive={activeSection === "mail"}
					/>
					<NavItem
						href="/app/calendar"
						icon={CalendarDaysIcon}
						label={t("app.menu.calendar")}
						isActive={activeSection === "calendar"}
					/>
					<NavItem
						href="/app/rules"
						icon={ListFilterIcon}
						label={t("app.menu.rules")}
						isActive={activeSection === "rules"}
					/>
					<NavItem
						href="/app/rules/assistant"
						icon={SparklesIcon}
						label={t("app.menu.aiAssistant")}
						isActive={activeSection === "ai"}
					/>

					{/* Mail sub-items when mail is active */}
					{activeSection === "mail" && (
						<div className="mt-2 flex flex-col gap-0.5">
							<Button
								asChild
								variant="default"
								className="mb-3 w-full gap-2 justify-start rounded-2xl bg-accent text-accent-foreground hover:bg-accent/80 shadow-sm"
							>
								<Link href="/app/mailboxes?folder=inbox&compose=true">
									<PencilIcon className="size-4" />
									Compose
								</Link>
							</Button>

							{[
								{ label: "Inbox", href: "/app/mailboxes?folder=inbox", icon: InboxIcon },
								{ label: "All Mail", href: "/app/mailboxes?folder=all", icon: MailIcon },
								{ label: "Sent", href: "/app/mailboxes?folder=sent", icon: SendIcon },
								{ label: "Drafts", href: "/app/mailboxes?folder=drafts", icon: MailIcon },
								{ label: "Trash", href: "/app/mailboxes?folder=trash", icon: Trash2Icon },
								{ label: "Spam", href: "/app/mailboxes?folder=spam", icon: MailIcon },
								{ label: "Scheduled", href: "/app/mailboxes?folder=scheduled", icon: ClockIcon },
								{ label: "Snoozed", href: "/app/mailboxes?folder=snoozed", icon: ClockIcon },
							].map((item) => {
								const currentFolder = searchParams.get("folder") ?? "inbox";
								const itemFolder =
									new URL(item.href, "http://x").searchParams.get("folder") ??
									item.label.toLowerCase();
								const isActive =
									pathname.startsWith("/app/mailboxes") && currentFolder === itemFolder;
								return (
									<Link
										key={item.href}
										href={item.href}
										className={cn(
											"flex items-center gap-3 px-3 py-1.5 rounded-lg text-sm transition-colors",
											isActive
												? "text-foreground font-semibold"
												: "text-muted-foreground hover:text-foreground hover:bg-black/5",
										)}
									>
										<item.icon className="size-4 shrink-0 opacity-60" />
										<span>{item.label}</span>
									</Link>
								);
							})}

							{/* Labels */}
							<div className="mt-4 px-1">
								<div className="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2 px-2">
									<span>Labels</span>
									<Link
										href="/app/rules"
										className="hover:text-foreground transition-colors"
										aria-label="Manage labels"
									>
										<PlusIcon className="size-3.5" />
									</Link>
								</div>
								{labelRules.length === 0 ? (
									<p className="px-3 text-xs text-muted-foreground/60 italic">No labels yet</p>
								) : (
									<div className="flex flex-col gap-0.5">
										{labelRules.map((label) => {
											const currentLabel = searchParams.get("label");
											const isActive =
												pathname.startsWith("/app/mailboxes") &&
												currentLabel === label.name;
											return (
												<Link
													key={label.id}
													href={`/app/mailboxes?folder=all&label=${encodeURIComponent(label.name)}`}
													className={cn(
														"flex items-center gap-3 px-3 py-1.5 rounded-lg text-sm transition-colors",
														isActive
															? "text-foreground font-semibold"
															: "text-muted-foreground hover:text-foreground hover:bg-black/5",
													)}
												>
													<span
														className="size-2.5 rounded-full shrink-0"
														style={{ backgroundColor: label.color }}
													/>
													<span className="truncate">{label.name}</span>
												</Link>
											);
										})}
									</div>
								)}
							</div>
						</div>
					)}

					{/* Admin / org settings */}
					{activeOrganization && isOrganizationAdmin && (
						<NavItem
							href={`${basePath}/settings`}
							icon={SettingsIcon}
							label={t("app.menu.organizationSettings")}
							isActive={pathname.startsWith(`${basePath}/settings/`)}
						/>
					)}
					{user?.role === "admin" && (
						<NavItem
							href="/app/admin"
							icon={UserCogIcon}
							label={t("app.menu.admin")}
							isActive={pathname.startsWith("/app/admin/")}
						/>
					)}
				</div>

				{/* Bottom section */}
				<div className="shrink-0 border-t border-border/60 px-2 py-3 flex flex-col gap-0.5">
					{webConfig.docsLink && (
						<a
							href={webConfig.docsLink}
							className="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-black/5 transition-colors"
						>
							<BookIcon className="size-4 shrink-0" />
							<span>Documentation</span>
						</a>
					)}
					<Link
						href="/app/settings"
						className={cn(
							"flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors",
							pathname.startsWith("/app/settings")
								? "text-foreground font-semibold"
								: "text-muted-foreground hover:text-foreground hover:bg-black/5",
						)}
					>
						<SettingsIcon className="size-4 shrink-0" />
						<span>Settings</span>
					</Link>
					<button
						type="button"
						onClick={onLogout}
						className="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-black/5 transition-colors w-full text-left"
					>
						<LogOutIcon className="size-4 shrink-0" />
						<span>Log out</span>
					</button>

					{/* Org selector */}
					{authConfig.organizations.enable && !authConfig.organizations.hideOrganization && (
						<div className="mt-1 px-1">
							<OrganzationSelect collapsed={false} />
						</div>
					)}

					{/* User menu */}
					<div className="mt-1 px-1">
						<UserMenu />
					</div>
				</div>
			</aside>
		</TooltipProvider>
	);
}
