{
	"name": "sarvam-ai-mcp-server",
	"version": "1.0.0",
	"description": "MCP server wrapping Sarvam AI's Translation REST API as a sarvam_translate tool.",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"sarvam-ai-mcp-server": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx index.ts",
		"start:http": "node dist/http.js",
		"dev:http": "tsx http.ts",
		"inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
	},
	"dependencies": {
		"@aws-sdk/client-secrets-manager": "^3.700.0",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"axios": "^1.7.9",
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
