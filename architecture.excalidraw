    {
      "id": "HV6DMZMZ7SCHvXgcFZPql",
      "type": "text",
      "x": 487.33946362051165,
      "y": 4762.216196638005,
      "width": 563.671875,
      "height": 368.55,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 700683646,
      "version": 1005,
      "versionNonce": 1497112254,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785679212496,
      "link": null,
      "locked": false,
      "text": "popsuites/\n├─ apps/\n│  ├─ templer/          → Templer app          (templer.popsuites.ai)\n│  ├─ linktree/          → Linktree Clone app  (linktree.popsuites.ai)\n│  ├─ hub(Mail service)  → Suite switcher       (mail.popsuites.ai)\n│  └─ marketing/         → Landing site         (popsuites.com)\n│\n├─ services/\n│  └─ core-service/      → STANDALONE MICROSERVICE (own submodule & CI/CD)\n│     ├─ auth/           → login, sessions, passkeys, magic links\n│     ├─ users/          → profiles, organizations, roles\n│     ├─ billing/        → plans, subscriptions, Stripe sync\n│     └─ db/             → owns the ONE database below\n│\n├─ packages/\n│  ├─ core-client/       → SDK all 3 apps use to call core-service\n│  ├─ ui/                → shared design system\n│  ├─ types/             → shared Zod schemas\n│  └─ config/            → shared eslint / tsconfig / biome\n│\n└─ tooling/               → shared build & lint config",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": null,
      "originalText": "popsuites/\n├─ apps/\n│  ├─ templer/          → Templer app          (templer.popsuites.ai)\n│  ├─ linktree/          → Linktree Clone app  (linktree.popsuites.ai)\n│  ├─ hub(Mail service)  → Suite switcher       (mail.popsuites.ai)\n│  └─ marketing/         → Landing site         (popsuites.com)\n│\n├─ services/\n│  └─ core-service/      → STANDALONE MICROSERVICE (own submodule & CI/CD)\n│     ├─ auth/           → login, sessions, passkeys, magic links\n│     ├─ users/          → profiles, organizations, roles\n│     ├─ billing/        → plans, subscriptions, Stripe sync\n│     └─ db/             → owns the ONE database below\n│\n├─ packages/\n│  ├─ core-client/       → SDK all 3 apps use to call core-service\n│  ├─ ui/                → shared design system\n│  ├─ types/             → shared Zod schemas\n│  └─ config/            → shared eslint / tsconfig / biome\n│\n└─ tooling/               → shared build & lint config",
      "lineHeight": 1.35,
      "index": "aj",
      "autoResize": true
    },
