# ... for server-side GA4 conversion events via the Measurement Protocol
# (sign_up, gmail_connect, outlook_connect, zoom_connect, zoho_connect,
# first_summary_viewed, purchase, plus voice/calendar engagement events).
# Measurement ID is the same "G-XXXXXXX" as NEXT_PUBLIC_GOOGLE_ANALYTICS_ID;
# the API secret is created in GA4 Admin -> Data Streams -> (web stream) ->
# Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
# Set to "true" to route server events to GA4's /debug/mp/collect endpoint and
# log the validation response instead of sending real hits (local testing only).
GA4_USE_DEBUG_ENDPOINT=""
# Deploy environment. Needs the NEXT_PUBLIC_ prefix because it's also read in
# client components (to hide billing UI and skip loading GA/GTM scripts on
# staging), not just in server code stamping the `environment` GA4 param.
#
# IMPORTANT: NEXT_PUBLIC_ vars are inlined into the build output at `next
# build` time, for both the client bundle AND server components — an Azure
# App Service "Application setting" alone does nothing for this variable,
# because nothing reads it at request time. It MUST be set as a build-time
# env var on whatever CI step runs `pnpm --filter web build`
# (.github/workflows/deploy-staging.yml sets it to "staging" directly; local
# dev picks it up from this file). Unset locally falls back to APP_ENV, then
# NODE_ENV ("development"). Register a matching event-scoped custom dimension
# in GA4 Admin and filter reports to environment=production.
#
# On staging: billing/plan UI is hidden and every user is granted the top
# paid plan for free (see packages/payments/lib/helper.ts), and GA4 events
# (both server-side Measurement Protocol and client-side gtag/GTM) are
# skipped entirely — staging traffic is dev activity, not real usage.
NEXT_PUBLIC_APP_ENV=""
# Legacy fallback for the above. Same build-time-inlining caveat applies.
# Prefer NEXT_PUBLIC_APP_ENV.
APP_ENV=""

# Cookie consent banner
# ... for Enzuzo (script UUID from your Enzuzo dashboard's install snippet,
# https://app.enzuzo.com/scripts/cookiebar/<id> — installed with the
# "Consent Mode - With GTM Template" method, so add the matching consent
# template inside your GTM container's Template Gallery too)
NEXT_PUBLIC_ENZUZO_COOKIEBAR_ID=""

# Storage
# This project uses Azure Blob Storage. Set the account name and an access key
# from the Azure portal (Storage account > Access keys). The avatars container
# below must already exist in that account.
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
# ... with Google Gemini (required for AI-based rule conditions)
GOOGLE_GENERATIVE_AI_API_KEY=""
# ... with Sarvam (free-tier voice transcription + email generation)
SARVAM_API_KEY=""

# Rate limiting
# Set to "1" to bypass the API rate limiter entirely (useful for local dev
# when hot-reload spams /auth and /api paths). Leave unset in production.
DISABLE_RATE_LIMIT=""

# Gmail Pub/Sub (for real-time Gmail push notifications)
GOOGLE_PUBSUB_TOPIC=""

# Cron job secret (gates all /api/internal/* endpoints incl. Telegram webhook
# registration and the digest cron; sent as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=""

# Metrics scrape token (gates GET /api/metrics; sent by the Alloy collector as
# `Authorization: Bearer <METRICS_SCRAPE_TOKEN>`. Unset = no-op, same as
# CRON_SECRET — fine for local dev, but MUST be set in staging/prod or the
# endpoint is public.)
METRICS_SCRAPE_TOKEN=""

# Telegram bot
# NOTE: during the migration a personal/local bot was reused for dev. That token
# is NOT committed and must NOT be used in production — create a separate bot in
# @BotFather and set its token here for each real environment.
TELEGRAM_BOT_TOKEN=""
# Bot username (without @), used to build t.me/<username>?start=... deep links
TELEGRAM_BOT_USERNAME=""
# Must match the secret_token you register with Telegram's setWebhook
TELEGRAM_WEBHOOK_SECRET="A_RANDOM_SECRET_FOR_TELEGRAM_WEBHOOKS"
# Public HTTPS endpoint Telegram calls; defaults to NEXT_PUBLIC_SITE_URL + /api/webhooks/telegram.
# In staging this is the stable Azure URL, e.g.
# https://<app>.azurewebsites.net/api/webhooks/telegram
TELEGRAM_WEBHOOK_URL=""

# Trusted origins (comma-separated extra origins, e.g. ngrok tunnel URL)
# BETTER_AUTH_TRUSTED_ORIGINS="https://abc123.ngrok-free.app"

# Zoom (video meetings) — user-managed OAuth app
# Create an OAuth app (User-managed) at https://marketplace.zoom.us, then:
#   1. Add this exact redirect URL (matches NEXT_PUBLIC_SITE_URL):
#        <NEXT_PUBLIC_SITE_URL>/api/auth/oauth2/callback/zoom
#      e.g. https://staging.popsuites.ai/api/auth/oauth2/callback/zoom
#   2. Grant scopes to create meetings + read the user: meeting:write:meeting
#      and user:read:user (older apps use meeting:write / user:read — set
#      ZOOM_SCOPES to match). The Zoom connect option is hidden until these are set.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Optional: override the requested OAuth scopes (comma-separated) to match your app.
# ZOOM_SCOPES="meeting:write:meeting,user:read:user"

# Zoho Meeting (video meetings) — user-managed OAuth app
# Create a "Server-based Applications" client at https://api-console.zoho.com, then:
#   1. Add the redirect URL for local testing:
#        http://localhost:3000/api/auth/oauth2/callback/zoho
#      Zoho accepts plain http:// only for localhost. The URL always follows
#      NEXT_PUBLIC_SITE_URL, so for staging add a second redirect URL alongside it:
#        https://staging.popsuites.ai/api/auth/oauth2/callback/zoho
#      (Zoho's console takes multiple redirect URLs, comma-separated — add both and
#      the same client works in either environment.)
#   2. Copy the generated Client ID / Client Secret below. The Zoho connect option
#      stays disabled ("Not available yet") until both are set.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Optional: override the requested OAuth scopes (comma-separated).
# Do NOT add `openid`: Zoho then treats the request as pure OIDC and silently
# drops ZohoMeeting.meeting.CREATE, so every Meeting call fails with
# INVALID_OAUTHSCOPE. The Zoho account also needs a VERIFIED email address, or
# Zoho withholds it and login fails with `email_is_missing`.
# ZOHO_SCOPES="ZohoMeeting.meeting.CREATE,AaaServer.profile.READ"
# Zoho is data-centre scoped: an account created outside the US DC only works
# against its own domains. Set BOTH to your DC (.eu / .in / .com.au / .jp) —
# e.g. for India: https://accounts.zoho.in and https://meeting.zoho.in
# ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.com"
# ZOHO_MEETING_DOMAIN="https://meeting.zoho.com"

# Sequenzy (email sequences - enrolls new signups in the Product Onboarding sequence)
SEQUENZY_API_KEY=""




