# Site url
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
# AES-256-GCM key used to encrypt OAuth tokens (Account.accessToken/refreshToken/idToken)
# at rest. Must be a base64-encoded 32-byte key — generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY="A_BASE64_ENCODED_32_BYTE_KEY"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
