# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# ... if you use Supabase
DIRECT_URL=""

# Site url
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# ... for Microsoft Outlook (register app at https://entra.microsoft.com)
MICROSOFT_CLIENT_ID="YOUR_MICROSOFT_CLIENT_ID"
MICROSOFT_CLIENT_SECRET="YOUR_MICROSOFT_CLIENT_SECRET"
MICROSOFT_TENANT_ID="common"

# Mails
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Plunk
PLUNK_API_KEY=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Contat form
CONTACT_FORM_TO_MAIL="hello@your-domain.com"

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
NEXT_PUBLIC_PRICE_ID_PRO_MONTHLY="asdf"
NEXT_PUBLIC_PRICE_ID_PRO_YEARLY="asdf"
NEXT_PUBLIC_PRICE_ID_LIFETIME="asdf"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# ... for Google Ads (gtag AW- ID)
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Storage
# This project uses Azure Blob Storage. Set the account name and an access key
# from the Azure portal (Storage account > Access keys). The avatars container
# below must already exist in that account.
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
# ... with Google Gemini (required for AI-based rule conditions)
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Rate limiting
# Set to "1" to bypass the API rate limiter entirely (useful for local dev
# when hot-reload spams /auth and /api paths). Leave unset in production.
DISABLE_RATE_LIMIT=""

# Gmail Pub/Sub (for real-time Gmail push notifications)
GOOGLE_PUBSUB_TOPIC=""

# Cron job secret (for /api/internal/cron/renew-watches)
CRON_SECRET=""

# Telegram bot
# Use the temporary bot token locally, then rotate it in BotFather before production.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="Mjy5bot"
TELEGRAM_WEBHOOK_SECRET="A_RANDOM_SECRET_FOR_TELEGRAM_WEBHOOKS"
# Optional override; defaults to NEXT_PUBLIC_SITE_URL + /api/webhooks/telegram
TELEGRAM_WEBHOOK_URL=""

# Trusted origins (comma-separated extra origins, e.g. ngrok tunnel URL)
# BETTER_AUTH_TRUSTED_ORIGINS="https://abc123.ngrok-free.app"
